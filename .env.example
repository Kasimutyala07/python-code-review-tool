# Environment Variables Example
# Duplicate this file to .env and insert your free-tier API key:

# Option A: Google Gemini Free Tier (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Option B: Groq Cloud Free Tier (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Default provider choice ('gemini', 'groq', or 'mock')
LLM_PROVIDER=mock
